# Only synthetic TEST values are allowed in local and staging environments.
KPI_APP_ENV=local
KPI_APP_NAME=kpi-ppmi-mesir
KPI_REQUEST_ID_HEADER=x-request-id
KPI_TEST_AUTH_ENABLED=true

# Hosted sign-in requires a KPI-managed Supabase project and approved accounts.
# Keep the provider unset until those are configured in Vercel secret storage.
# KPI_AUTH_PROVIDER=supabase
# KPI_SUPABASE_URL=https://your-project.supabase.co
# KPI_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: organization code in the KPI database (default KPI_PPMI_MESIR).
# KPI_ORGANIZATION_CODE=KPI_PPMI_MESIR

# Production requires an explicit deployment configuration owned by KPI.
# Do not place database URLs, API keys, or production credentials in this file.
# Deployment secret names: KPI_SUPABASE_URL and KPI_SUPABASE_SERVICE_ROLE_KEY.
# Configure both only in KPI-owned production secret storage.
