KPI_APP_ENV=production
KPI_APP_NAME=kpi-ppmi-mesir
KPI_REQUEST_ID_HEADER=x-request-id
KPI_TEST_AUTH_ENABLED=false
KPI_AUTH_PROVIDER=supabase
# Store actual values only in Vercel Production secrets.
KPI_SUPABASE_URL=https://your-production-project.supabase.co
KPI_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key
KPI_SUPABASE_SERVICE_ROLE_KEY=replace-with-production-server-secret

# Optional approved AI adapter. No user text is sent before an active SOP processor approval.
# Endpoint accepts {model,question,sources,instruction} and returns {answer,citations,draft}.
# KPI_AI_PROVIDER_URL=https://approved-provider.example/kpi-adapter
# KPI_AI_PROVIDER_TOKEN=server-only-secret
# KPI_AI_PROVIDER_MODEL=approved-model

# Optional scheduled publication/reminders and approved notification adapters.
# CRON_SECRET=
# KPI_EMAIL_DELIVERY_URL=
# KPI_EMAIL_DELIVERY_TOKEN=
# KPI_WHATSAPP_DELIVERY_URL=
# KPI_WHATSAPP_DELIVERY_TOKEN=
